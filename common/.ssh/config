# SSH 配置文件模板
# 复制此文件到 ~/.ssh/config 并添加你的主机配置
# 私有配置可以放在 ~/.ssh/config.local

# 默认全局设置
Host *
    # 安全设置
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # 压缩
    Compression yes

    # 密钥优先级
    IdentitiesOnly yes

    # 使用 SSH agent
    AddKeysToAgent yes

    # 支持 SSH agent forwarding
    ForwardAgent no

    # 协议偏好
    AddressFamily any

# 示例主机配置（取消注释并修改）:
# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22
#
# Host myserver
#     HostName 192.168.1.100
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22
#
# Host *.internal
#     User admin
#     IdentityFile ~/.ssh/id_internal
