FROM ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 更新系统并安装基础工具
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    git \
    vim \
    sudo \
    curl \
    wget && \
    apt-get clean

# 创建测试用户
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser

ENV SHELL=/bin/bash

CMD ["/bin/bash"]
