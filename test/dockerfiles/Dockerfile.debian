# 支持镜像加速
ARG DOCKER_MIRROR=""
FROM ${DOCKER_MIRROR}debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    build-essential \
    git \
    vim \
    sudo \
    curl \
    wget \
    unzip \
    zip \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    liblzma-dev \
    libncurses-dev \
    ca-certificates \
    gnupg && \
    apt-get clean

RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser

ENV SHELL=/bin/bash

CMD ["/bin/bash"]
