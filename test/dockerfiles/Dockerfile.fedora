# 支持镜像加速
ARG DOCKER_MIRROR=""
FROM ${DOCKER_MIRROR}fedora:39

RUN dnf update -y && \
    dnf install -y \
    @development-tools \
    git \
    vim \
    sudo \
    curl \
    wget \
    unzip \
    zip \
    openssl-devel \
    zlib-devel \
    bzip2-devel \
    readline-devel \
    sqlite-devel \
    libffi-devel \
    xz-devel \
    ncurses-devel \
    ca-certificates \
    gnupg && \
    dnf clean all

RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser

ENV SHELL=/bin/bash

CMD ["/bin/bash"]
